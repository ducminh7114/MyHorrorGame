MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 603601055}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d0423b6e668df324e9022a192d51ec0f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialoguemanagement
  conversationPanel: {fileID: 1066576855}
  intText: {fileID: 2572602943446893597}
  subjectText: {fileID: 533399440}
  bodyText: {fileID: 167484042}
  dialogues:
  - subjectName: Mistery person
    dialogue: 'You shouldn''t be here. '
    skipable: 1
    lettersPerSecond: 15
  - subjectName: Mistery person
    dialogue: Everyone suppose to stay in their room and must not come out except
      in their test scedule.
    skipable: 1
    lettersPerSecond: 15
  - subjectName: You
    dialogue: I know. But this place starts become weird. I even heard some strage
      noise outside the door.
    skipable: 1
    lettersPerSecond: 15
  - subjectName: Mistery person
    dialogue: ...
    skipable: 1
    lettersPerSecond: 15
  - subjectName: Mistery person
    dialogue: It's nearly impossible. Every elevator and stair is locked with electric
      keypad.
    skipable: 1
    lettersPerSecond: 15
  - subjectName: You
    dialogue: What?! So there is no other way?
    skipable: 1
    lettersPerSecond: 15
  - subjectName: Mistery person
    dialogue: However..., since you already out there, you could help me find a metal
      box.
    skipable: 1
    lettersPerSecond: 15
  - subjectName: Mistery person
    dialogue: That one of those doctor's databox.
    skipable: 1
    lettersPerSecond: 15
  - subjectName: Mistery person
    dialogue: If you can get it, I maybe able to make a spare key for you.
    skipable: 1
    lettersPerSecond: 15
  - subjectName: You
    dialogue: Seem like that my only option.
    skipable: 1
    lettersPerSecond: 15
  - subjectName: Mistery person
    dialogue: That right, so try your best.
    skipable: 1
    lettersPerSecond: 15
  repeatDialogue: Find that missing box for me, then I will help you get out of here.
  lookTarget: {fileID: 296244382}
  lookDuration: 1
  zoomFOV: 40
  zoomOutTime: 0.5
  player: {fileID: 1822386497}
  pause: {fileID: 846407507}
  gunSystem: {fileID: 606151585}
  playerCamera: {fileID: 1447922619}
